# Sentinel backend environment
# Copy this file to backend/.env, then replace the placeholders.
# Docker Compose reads backend/.env; for local Node commands run from backend/.
# Never commit your real .env file or share its secrets.

# Required: use a Neon PostgreSQL connection string and two different,
# long random secrets. Render supplies PORT automatically for its web service.
PORT=8000
NODE_ENV=development
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-secret

# API / infrastructure. On Render, set CORS_ORIGIN to the exact Vercel origin
# and REDIS_URL to your Redis-compatible service URL. Compose overrides REDIS_URL
# with redis://redis:6379. LOG_FORMAT=json is recommended for hosted deployments;
# pretty requires the development-only pino-pretty package.
CORS_ORIGIN=http://localhost:5173
REDIS_URL=redis://localhost:6379
LOG_FORMAT=json

# Optional: required only for Google sign-in.
GOOGLE_CLIENT_ID=

# Scheduler / queue settings (milliseconds unless otherwise noted).
SCHEDULER_POLL_INTERVAL_MS=15000
CHECK_QUEUE_NAME=sentinel.checks
RESULT_QUEUE_NAME=sentinel.results
SCHEDULER_LEASE_TTL_MS=15000
SCHEDULER_LEASE_RENEW_MS=5000
SCHEDULER_LEASE_SAFETY_MS=2000
# Optional scheduler identity; omit for an automatically generated unique ID.
# Set a different value for each scheduler. Compose supplies scheduler-a/b.
# SCHEDULER_ID=scheduler-1

# Worker settings. WORKER_ID must be unique for each process sharing Redis;
# omit it for an automatically generated ID. Compose supplies per-service IDs,
# regions and concurrency. A standalone worker defaults to the default region.
# WORKER_ID=worker-1
WORKER_REGION=default
WORKER_CONCURRENCY=5
HEARTBEAT_INTERVAL_MS=10000
HEARTBEAT_TTL_S=30
STALLED_INTERVAL_MS=30000
MAX_STALLED_COUNT=2

# Incident detection. Every region listed here needs a worker consuming that
# region's queue. The values below match the three Docker Compose workers.
# For a standalone default-region worker, use QUORUM_REGIONS=default and
# QUORUM_MIN_REGIONS=1 instead.
INCIDENT_DETECTION_THRESHOLD=3
QUORUM_REGIONS=mumbai,singapore,frankfurt
QUORUM_MIN_REGIONS=2
QUORUM_CORRELATION_WINDOW_MS=60000

# Alert delivery. Email channels require a Resend API key and a verified sender.
# Webhook channels do not require a Resend key.
ALERT_DISPATCHER_POLL_MS=5000
ALERT_MAX_RETRIES=5
RESEND_API_KEY=
RESEND_FROM="Sentinel <alerts@sentinel.dev>"
WEBHOOK_TIMEOUT_MS=10000
