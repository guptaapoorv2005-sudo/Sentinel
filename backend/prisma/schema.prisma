// Prisma schema for Sentinel.
// In Prisma 7, the connection URL is configured in prisma.config.js,
// not here. This file defines only the generator and datasource provider.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  passwordHash String?      @map("password_hash")
  googleId     String?      @unique @map("google_id")
  authProvider AuthProvider @default(LOCAL) @map("auth_provider")
  refreshToken String?      @map("refresh_token")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  // A user can own many monitors.
  monitors Monitor[]

  @@map("users")
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
  HEAD
  OPTIONS
}

model Monitor {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String     @map("user_id") @db.Uuid
  name           String
  url            String
  method         HttpMethod @default(GET)
  interval       Int        @default(300) // seconds, min 30 (30s)
  timeout        Int        @default(10000) // ms, default 10s
  expectedStatus Int        @default(200) @map("expected_status")
  enabled        Boolean    @default(true)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  // Current state - denormalized for fast dashboard reads.
  // These are updated by the result processor, keyed on executionSlot
  // ordering to prevent late-arriving results from corrupting state.
  //
  // lastEvaluatedSlot: the executionSlot of the last result that was used
  //   to update this monitor's current state. Stored as BigInt to match
  //   CheckResult.executionSlot. If an incoming result's executionSlot is
  //   <= lastEvaluatedSlot it is a late-arrival; it is persisted as a
  //   CheckResult row but does NOT update current state.
  currentStatus       MonitorStatus @default(UNKNOWN) @map("current_status")
  lastCheckedAt       DateTime?     @map("last_checked_at")
  lastStatusChange    DateTime?     @map("last_status_change")
  consecutiveFailures Int           @default(0) @map("consecutive_failures")
  lastEvaluatedSlot   BigInt?       @map("last_evaluated_slot")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A monitor can have many check results.
  checkResults CheckResult[]

  // INDEX JUSTIFICATION:
  // - userId: Every monitor query filters by the authenticated user's ID.
  //   Without this index, listing monitors would require a full table scan.
  @@index([userId])
  @@map("monitors")
}

enum MonitorStatus {
  UP
  DOWN
  UNKNOWN
}

enum CheckStatus {
  UP
  DOWN
}

/// A single health-check observation produced by a worker.
///
/// KEY DESIGN DECISIONS:
///   - `@@unique([monitorId, executionSlot])` is the idempotency key.
///     If a job is processed twice (at-least-once delivery), the second
///     upsert updates the existing row rather than inserting a duplicate.
///   - `executionSlot` is BigInt because ms-precision Unix timestamps exceed
///     PostgreSQL/Prisma's 32-bit Int range.
///   - `statusCode`, `responseTimeMs`, and `failureType` are nullable —
///     a timeout or DNS error produces no HTTP response.
///   - Cascade delete: removing a monitor removes its check history.
model CheckResult {
  id             String      @id @default(uuid()) @db.Uuid
  monitorId      String      @map("monitor_id") @db.Uuid
  executionSlot  BigInt      @map("execution_slot")
  jobId          String      @map("job_id")
  workerId       String      @map("worker_id")
  region         String      @default("default")
  status         CheckStatus
  statusCode     Int?        @map("status_code")
  responseTimeMs Int?        @map("response_time_ms")
  failureType    String?     @map("failure_type")
  checkedAt      DateTime    @map("checked_at")
  createdAt      DateTime    @default(now()) @map("created_at")

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  // IDEMPOTENCY: one result per monitor per execution slot.
  @@unique([monitorId, executionSlot], name: "uq_check_result_slot")
  // INDEX JUSTIFICATION:
  // - (monitorId, checkedAt): The most common query pattern — recent results
  //   for a given monitor. Used by the dashboard and incident detector.
  @@index([monitorId, checkedAt])
  @@map("check_results")
}
