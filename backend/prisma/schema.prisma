// Prisma schema for Sentinel.
// In Prisma 7, the connection URL is configured in prisma.config.js,
// not here. This file defines only the generator and datasource provider.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  passwordHash String?      @map("password_hash")
  googleId     String?      @unique @map("google_id")
  authProvider AuthProvider @default(LOCAL) @map("auth_provider")
  refreshToken String?      @map("refresh_token")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  // A user can own many monitors.
  monitors Monitor[]

  @@map("users")
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
  HEAD
  OPTIONS
}

model Monitor {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String     @map("user_id") @db.Uuid
  name           String
  url            String
  method         HttpMethod @default(GET)
  interval       Int        @default(300) // seconds, min 30 (30s)
  timeout        Int        @default(10000) // ms, default 10s
  expectedStatus Int        @default(200) @map("expected_status")
  enabled        Boolean    @default(true)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  // Current state - denormalized for fast dashboard reads.
  // These are updated by the result processor, keyed on executionSlot
  // ordering to prevent late-arriving results from corrupting state.
  //
  // lastEvaluatedSlot: the executionSlot of the last result that was used
  //   to update this monitor's current state. Stored as BigInt to match
  //   CheckResult.executionSlot. If an incoming result's executionSlot is
  //   <= lastEvaluatedSlot it is a late-arrival; it is persisted as a
  //   CheckResult row but does NOT update current state.
  currentStatus       MonitorStatus @default(UNKNOWN) @map("current_status")
  lastCheckedAt       DateTime?     @map("last_checked_at")
  lastStatusChange    DateTime?     @map("last_status_change")
  consecutiveFailures Int           @default(0) @map("consecutive_failures")
  lastEvaluatedSlot   BigInt?       @map("last_evaluated_slot")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A monitor can have many check results.
  checkResults CheckResult[]

  // A monitor can have many incidents (at most one open at a time,
  // enforced by a partial unique index in the migration SQL).
  incidents Incident[]

  // Quorum-aggregated per-slot global statuses (Phase 8).
  slotResults SlotResult[]

  // INDEX JUSTIFICATION:
  // - userId: Every monitor query filters by the authenticated user's ID.
  //   Without this index, listing monitors would require a full table scan.
  @@index([userId])
  @@map("monitors")
}

enum MonitorStatus {
  UP
  DOWN
  UNKNOWN
}

enum CheckStatus {
  UP
  DOWN
}

/// A single health-check observation produced by one worker in one region.
///
/// KEY DESIGN DECISIONS:
///   - `@@unique([monitorId, executionSlot, region])` is the idempotency key.
///     Each region contributes exactly one observation per slot. If a job is
///     processed twice, the second upsert updates the existing row.
///   - `executionSlot` is BigInt because ms-precision Unix timestamps exceed
///     PostgreSQL/Prisma's 32-bit Int range.
///   - `statusCode`, `responseTimeMs`, and `failureType` are nullable —
///     a timeout or DNS error produces no HTTP response.
///   - Cascade delete: removing a monitor removes its check history.
model CheckResult {
  id             String      @id @default(uuid()) @db.Uuid
  monitorId      String      @map("monitor_id") @db.Uuid
  executionSlot  BigInt      @map("execution_slot")
  jobId          String      @map("job_id")
  workerId       String      @map("worker_id")
  region         String      @default("default")
  status         CheckStatus
  statusCode     Int?        @map("status_code")
  responseTimeMs Int?        @map("response_time_ms")
  failureType    String?     @map("failure_type")
  checkedAt      DateTime    @map("checked_at")
  createdAt      DateTime    @default(now()) @map("created_at")

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  // IDEMPOTENCY: one result per monitor per execution slot per region.
  // Phase 8: region added to the key; multiple workers can contribute to the
  // same slot without overwriting each other's observation.
  @@unique([monitorId, executionSlot, region], name: "uq_check_result_slot_region")
  // INDEX JUSTIFICATION:
  // - (monitorId, executionSlot): quorum aggregator queries all regional
  //   results for a given (monitor, slot).
  // - (monitorId, checkedAt): recent results for the dashboard.
  @@index([monitorId, executionSlot])
  @@index([monitorId, checkedAt])
  @@map("check_results")
}

/// Quorum-aggregated global status for one (monitor, execution slot).
///
/// Produced by the result processor after applying M-of-N quorum to the
/// regional CheckResults. One row per (monitorId, executionSlot).
///
/// globalStatus:
///   UP      — ≥ quorumMinRegions reported UP
///   DOWN    — ≥ quorumMinRegions reported DOWN
///   UNKNOWN — window expired without enough reports to decide either way
///
/// consecutiveFailures on Monitor is derived from SlotResult history,
/// not from individual CheckResults. UNKNOWN slots are transparent —
/// they do not break or extend a DOWN streak.
model SlotResult {
  id             String        @id @default(uuid()) @db.Uuid
  monitorId      String        @map("monitor_id") @db.Uuid
  executionSlot  BigInt        @map("execution_slot")
  globalStatus   MonitorStatus @map("global_status")  // UP | DOWN | UNKNOWN
  regionsUp      Int           @map("regions_up")
  regionsDown    Int           @map("regions_down")
  regionsMissing Int           @map("regions_missing")
  evaluatedAt    DateTime      @map("evaluated_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  // IDEMPOTENCY: exactly one aggregated result per (monitor, slot).
  @@unique([monitorId, executionSlot], name: "uq_slot_result")
  // INDEX JUSTIFICATION:
  // - (monitorId, executionSlot DESC): consecutive-failures window query.
  @@index([monitorId, executionSlot])
  @@map("slot_results")
}

// ── Incident State Machine (Phase 7 / Phase 8) ───────────────────────────────
//
// An Incident represents a confirmed failure event for a monitor.
//
// State transitions (Phase 8+):
//   null         → CONFIRMED    (created directly; quorum already applied)
//   CONFIRMED    → ACKNOWLEDGED (user-driven)
//   CONFIRMED/ACKNOWLEDGED → RESOLVED (consecutiveFailures drops to 0 after UP slot)
//
// DETECTED is kept in the enum for schema backward compatibility but is no
// longer written by the Phase 8 processor.
//
// At most one non-RESOLVED incident per monitor at any time, enforced by a
// partial unique index created in the migration SQL:
//   CREATE UNIQUE INDEX uq_monitor_open_incident
//     ON incidents (monitor_id)
//     WHERE status != 'RESOLVED';
//
// This index is the primary idempotency guard against duplicate incident creation
// under concurrent processing — no application-level check-then-insert race.

enum IncidentStatus {
  DETECTED
  CONFIRMED
  ACKNOWLEDGED
  RESOLVED
}

model Incident {
  id                     String         @id @default(uuid()) @db.Uuid
  monitorId              String         @map("monitor_id") @db.Uuid
  status                 IncidentStatus @default(DETECTED)
  failureCountAtDetection Int           @map("failure_count_at_detection")
  detectedAt             DateTime       @map("detected_at")
  confirmedAt            DateTime?      @map("confirmed_at")
  acknowledgedAt         DateTime?      @map("acknowledged_at")
  resolvedAt             DateTime?      @map("resolved_at")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")

  monitor Monitor         @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  events  IncidentEvent[]

  // INDEX JUSTIFICATION:
  // - (monitorId, status): The most common query — "does this monitor have an open incident?"
  // - (monitorId, detectedAt DESC): Listing incidents for a monitor, newest first.
  @@index([monitorId, status])
  @@index([monitorId, detectedAt])
  @@map("incidents")
}

/// An immutable audit event recording every state transition in an Incident's lifecycle.
///
/// fromStatus is nullable — the initial DETECTED event has no prior state.
model IncidentEvent {
  id         String          @id @default(uuid()) @db.Uuid
  incidentId String          @map("incident_id") @db.Uuid
  fromStatus IncidentStatus? @map("from_status")
  toStatus   IncidentStatus  @map("to_status")
  // Human-readable reason for the transition (e.g. 'threshold_reached', 'recovery', 'user_ack').
  reason     String
  // 'system' for automated transitions; userId for user-driven (ACKNOWLEDGED).
  actor      String          @default("system")
  createdAt  DateTime        @default(now()) @map("created_at")

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@map("incident_events")
}
